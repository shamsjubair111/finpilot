generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  passwordHash         String
  // False for accounts created with Google until the user sets a password via reset.
  passwordSet          Boolean  @default(true)
  googleId             String?  @unique
  // Referral program: my shareable code, who referred me, and when the reward was paid out.
  referralCode         String?  @unique
  referredById         String?
  referralRewardedAt   DateTime?
  avatarUrl            String?
  currency             String   @default("BDT")
  language             String   @default("en")
  monthlySalary        Float    @default(0)
  currentSavings       Float    @default(0)
  emergencyFundTarget  Float    @default(0)
  emergencyFundCurrent Float    @default(0)
  defaultSavingsTarget Float    @default(20)
  plan                 String   @default("free")
  planExpiresAt        DateTime?
  // The planExpiresAt a renewal reminder was already sent for.
  planReminderFor      DateTime?
  // IDs of rows created by "Explore with sample data", so they can be removed together.
  sampleData           Json?
  // Rates for foreign-currency accounts: { "USD": 121.5 } means 1 USD = 121.5 in the main currency.
  exchangeRates        Json?
  emailVerifiedAt      DateTime?
  onboardedAt          DateTime?
  sessionVersion       Int      @default(0)
  weeklySummary        Boolean  @default(true)
  weeklySummarySentAt  DateTime?
  // Two-step verification: encrypted TOTP secret, set when enabled; last used step blocks replays.
  totpSecret           String?
  totpEnabledAt        DateTime?
  totpLastStep         Int?
  recoveryCodes        String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transactions Transaction[]
  budgets      BudgetCategory[]
  goals        Goal[]
  purchases    Purchase[]
  commitments  Commitment[]
  accounts     Account[]
  authTokens   AuthToken[]
  investments  Investment[]
  pushSubscriptions PushSubscription[]
  ownedMemberships  Membership[] @relation("OwnedMemberships")
  customCategories  CustomCategory[]
  joinedMemberships Membership[] @relation("JoinedMemberships")
}

model Account {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String
  institution    String?
  accountNumber  String?
  openingBalance Float    @default(0)
  // Null = the user's main currency. Otherwise the balance is kept in this currency (see src/lib/fx.ts).
  currency       String?
  creditLimit    Float?
  interestRate   Float?
  color          String   @default("#6366f1")
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())

  transactions         Transaction[] @relation("TxnAccount")
  incomingTransfers    Transaction[] @relation("TxnToAccount")

  @@index([userId])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  merchant      String   @default("")
  category      String
  date          DateTime
  amount        Float
  type          String
  paymentMethod String   @default("card")
  notes         String?
  accountId     String?
  account       Account? @relation("TxnAccount", fields: [accountId], references: [id], onDelete: SetNull)
  toAccountId   String?
  toAccount     Account? @relation("TxnToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  externalId    String?
  // For transactions on a foreign-currency account: the amount in that account's currency.
  originalAmount   Float?
  originalCurrency String?
  // Optional split across categories: [{ category, amount }], parts add up to `amount`.
  splits        Json?
  receipt       Receipt?
  createdAt     DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, date])
}

model BudgetCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  budgeted  Float
  // Carry last month's unspent amount into this month.
  rollover  Boolean  @default(false)
  icon      String   @default("Wallet")
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  @@unique([userId, category])
}

model Goal {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  icon                String   @default("Target")
  color               String   @default("#6366f1")
  goalAmount          Float
  currentAmount       Float    @default(0)
  targetDate          DateTime
  monthlyContribution Float    @default(0)
  priority            String   @default("medium")
  category            String   @default("other")
  // When set, progress follows this account's balance instead of currentAmount.
  accountId           String?
  createdAt           DateTime @default(now())

  @@index([userId])
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  priority    String   @default("medium")
  savedAmount Float    @default(0)
  desiredDate DateTime
  category    String   @default("Other")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Commitment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("Bills")
  dueDate   DateTime
  amount    Float
  icon      String   @default("CalendarClock")
  recurring Boolean  @default(false)
  // weekly | monthly | quarterly | yearly (used when recurring)
  frequency       String    @default("monthly")
  // Day of month the schedule is anchored to, so a 31st bill returns to the 31st after short months.
  anchorDay       Int?
  type            String    @default("expense")
  accountId       String?
  // Post the transaction automatically when it falls due.
  autoPost        Boolean   @default(false)
  lastRemindedFor DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Single-use tokens for email verification and password reset. Only a SHA-256 hash is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  // Extra context for the token, e.g. the new address for an email change.
  data      String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// A plan period given to a user: a manual payment recorded by an admin (bKash, bank) or, later, a gateway payment.
// Kept without a foreign key so revenue history survives account deletion.
model PlanGrant {
  id        String   @id @default(cuid())
  userId    String
  email     String
  plan      String
  days      Int
  amount    Float    @default(0)
  currency  String   @default("BDT")
  reference String?
  source    String   @default("manual")
  grantedBy String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Investment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  kind           String
  institution    String?
  principal      Float     @default(0)
  rate           Float     @default(0)
  startDate      DateTime
  maturityDate   DateTime?
  payout         String    @default("maturity")
  monthlyDeposit Float?
  currentValue   Float?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// Security-relevant events shown to the user in Settings. No foreign key so the trail outlives deletions.
model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A browser/device that agreed to receive push notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// An online checkout. Credited exactly once (status pending → paid) after server-side validation.
model Payment {
  id        String    @id @default(cuid())
  userId    String
  tranId    String    @unique
  provider  String    @default("sslcommerz")
  plan      String
  period    String
  amount    Float
  currency  String    @default("BDT")
  status    String    @default("pending")
  valId     String?
  method    String?
  coupon    String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([userId, createdAt])
}

// Unexpected errors from the server and browsers, for the admin dashboard.
model ErrorEvent {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  path      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Shared household access: `member` can see (viewer) or also change (editor) `owner`'s finances.
model Membership {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation("OwnedMemberships", fields: [ownerId], references: [id], onDelete: Cascade)
  memberId   String?
  member     User?     @relation("JoinedMemberships", fields: [memberId], references: [id], onDelete: Cascade)
  email      String
  role       String    @default("editor")
  // Hash of the invite link token; cleared once accepted.
  inviteHash String?   @unique
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([ownerId, email])
  @@index([memberId])
}

// A photo of a receipt attached to a transaction (compressed in the browser before upload).
model Receipt {
  id            String      @id @default(cuid())
  userId        String
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  mime          String
  size          Int
  data          Bytes
  createdAt     DateTime    @default(now())

  @@index([userId])
}

// A category the household added on top of the built-in ones.
model CustomCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  createdAt DateTime @default(now())

  @@unique([userId, type, name])
}

// Discount codes for Pro checkout, created in /admin.
model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int
  maxUses    Int?
  uses       Int       @default(0)
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

// A message sent from the Help page; handled in /admin.
model SupportMessage {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  name       String
  topic      String
  message    String
  page       String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// AI assistant messages per household per month ("2026-10"), for the monthly cap.
model AssistantUsage {
  userId String
  month  String
  count  Int    @default(0)

  @@id([userId, month])
}
