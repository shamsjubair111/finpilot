DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
AUTH_SECRET="generate-with: openssl rand -base64 48"

# Optional: shown on the billing and legal pages as the contact/upgrade address.
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Email via Resend (https://resend.com). Without a key, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Sanchay <hello@your-domain.com>"
# Public base URL used in email links, e.g. https://sanchay.app (falls back to the request host).
APP_URL=""
