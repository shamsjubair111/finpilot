DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
AUTH_SECRET="generate-with: openssl rand -base64 48"

# Optional: shown on the billing and legal pages as the contact/upgrade address.
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Email via Resend (https://resend.com). Without a key, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Sanchay <hello@your-domain.com>"
# Public base URL used in email links, e.g. https://sanchay.app (falls back to the request host).
APP_URL=""

# Comma-separated emails that can open /admin (users, plans, revenue, manual Pro grants).
ADMIN_EMAILS=""

# Shared secret for scheduled jobs (/api/cron/*). Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=""

# Google sign-in (optional). Create an OAuth client (Web) in Google Cloud Console with redirect URI
# <APP_URL>/api/auth/google/callback. The button appears only when both are set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web push (optional). Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, e.g. mailto:support@your-domain.com
VAPID_SUBJECT=""

# SSLCommerz online payments (bKash, Nagad, cards…). Sandbox until SSLCOMMERZ_LIVE="true".
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_LIVE="false"
